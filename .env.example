# Optional: paste your Formspree form ID (e.g. "xyzabcd") so the contact form
# sends real emails. Leave empty and the form only validates on the page.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional: your public domain (e.g. "https://anilamerovci.com"). Used for the
# sitemap and social previews. On Vercel it defaults to the production URL.
NEXT_PUBLIC_SITE_URL=

# ---- Admin panel (/admin) ----
# Supabase project: Settings → API. The service-role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The one admin login. Password must be at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: any long random string. Changing it signs everyone out.
ADMIN_SESSION_SECRET=
